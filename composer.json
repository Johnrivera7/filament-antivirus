{
    "name": "johnrivera7/filament-antivirus",
    "description": "Filament Antivirus — ClamAV upload scanning, quarantine and file security dashboard for Laravel.",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "antivirus",
        "clamav",
        "malware",
        "quarantine",
        "security"
    ],
    "homepage": "https://github.com/Johnrivera7/filament-antivirus",
    "license": "MIT",
    "authors": [
        {
            "name": "John Rivera",
            "email": "johnriveragonzalez7@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^11.28|^12.0|^13.0",
        "illuminate/support": "^11.28|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16",
        "symfony/process": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "JohnRivera7\\FilamentAntivirus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JohnRivera7\\FilamentAntivirus\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JohnRivera7\\FilamentAntivirus\\FilamentAntivirusServiceProvider"
            ],
            "aliases": {
                "Antivirus": "JohnRivera7\\FilamentAntivirus\\Facades\\Antivirus"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "pint": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
